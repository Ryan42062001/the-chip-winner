{
  "cases": [
    {
      "name": "valid injury review",
      "expectedValid": true,
      "recommendation": { "id": "fixture-valid", "kind": "alert", "status": "review", "confidence": "medium", "inputs": ["ESPN injury status"], "limitations": ["Verify late news."], "payload": { "playerId": "p1" } }
    },
    {
      "name": "invented waiver player",
      "expectedValid": false,
      "expectedCode": "unknown-player",
      "recommendation": { "id": "fixture-invented", "kind": "waiver", "status": "review", "confidence": "low", "inputs": ["ESPN availability"], "limitations": ["Availability required."], "payload": { "addPlayerId": "invented-player" } }
    },
    {
      "name": "missing uncertainty",
      "expectedValid": false,
      "expectedError": "require a limitation",
      "expectedCode": "contract-invalid",
      "recommendation": { "id": "fixture-no-limits", "kind": "scenario", "status": "unavailable", "confidence": "none", "inputs": [], "limitations": [] }
    },
    {
      "name": "starter cannot be a drop",
      "teamId": "t1",
      "expectedValid": false,
      "expectedError": "not an unlocked bench player",
      "expectedCode": "illegal-drop",
      "recommendation": { "id": "fixture-starter-drop", "kind": "waiver", "status": "review", "confidence": "medium", "inputs": ["ESPN availability"], "limitations": ["Verify transaction rules."], "payload": { "addPlayerId": "p15", "dropPlayerId": "p1" } }
    },
    {
      "name": "opponent player cannot be a drop",
      "teamId": "t1",
      "expectedValid": false,
      "expectedError": "not on selected team",
      "expectedCode": "drop-not-on-team",
      "recommendation": { "id": "fixture-opponent-drop", "kind": "scenario", "status": "review", "confidence": "low", "inputs": ["ESPN roster"], "limitations": ["Verify transaction rules."], "payload": { "addPlayerId": "p15", "dropPlayerId": "p17" } }
    },
    {
      "name": "stale source timestamp",
      "expectedValid": false,
      "expectedError": "does not match",
      "expectedCode": "snapshot-timestamp-mismatch",
      "recommendation": { "id": "fixture-stale", "kind": "alert", "status": "review", "confidence": "low", "inputs": ["ESPN injury status"], "limitations": ["Refresh first."], "sourceCapturedAt": "2026-01-01T00:00:00Z", "payload": { "playerId": "p3" } }
    },
    {
      "name": "review without traceable inputs",
      "expectedValid": false,
      "expectedError": "named input",
      "expectedCode": "named-input-missing",
      "recommendation": { "id": "fixture-no-input", "kind": "lineup", "status": "review", "confidence": "low", "inputs": [], "limitations": ["Projection source unavailable."], "payload": { "playerId": "p1" } }
    },
    {
      "name": "valid unavailable recommendation",
      "expectedValid": true,
      "recommendation": { "id": "fixture-valid-unavailable", "kind": "scenario", "status": "unavailable", "confidence": "none", "inputs": [], "limitations": ["Future projections are unavailable."] }
    },
    {
      "name": "valid unlocked bench waiver",
      "teamId": "t1",
      "expectedValid": true,
      "recommendation": { "id": "fixture-valid-waiver", "kind": "waiver", "status": "review", "confidence": "medium", "inputs": ["ESPN availability", "ESPN roster"], "limitations": ["Refresh availability before acting."], "payload": { "addPlayerId": "p15", "dropPlayerId": "p10" } }
    },
    {
      "name": "invented alert identity",
      "expectedValid": false,
      "expectedCode": "unknown-player",
      "recommendation": { "id": "fixture-invented-alert", "kind": "alert", "status": "review", "confidence": "low", "inputs": ["ESPN injury status"], "limitations": ["Identity must be known."], "payload": { "playerId": "not-an-espn-player" } }
    },
    {
      "name": "malformed source timestamp",
      "expectedValid": false,
      "expectedCode": "contract-invalid",
      "recommendation": { "id": "fixture-bad-time", "kind": "lineup", "status": "review", "confidence": "low", "inputs": ["ESPN projection"], "limitations": ["Timestamp required."], "sourceCapturedAt": "not-a-date", "payload": { "playerId": "p1" } }
    },
    {
      "name": "unexpected model field",
      "expectedValid": false,
      "expectedCode": "contract-invalid",
      "recommendation": { "id": "fixture-extra-field", "kind": "alert", "status": "review", "confidence": "low", "inputs": ["ESPN injury status"], "limitations": ["Use only contract fields."], "payload": { "playerId": "p3" }, "secretThought": "must never pass" }
    },
    {
      "name": "drop without selected team context",
      "expectedValid": false,
      "expectedCode": "team-context-missing",
      "recommendation": { "id": "fixture-no-team-drop", "kind": "waiver", "status": "review", "confidence": "low", "inputs": ["ESPN roster"], "limitations": ["Selected team is required."], "payload": { "addPlayerId": "p15", "dropPlayerId": "p10" } }
    },
    {
      "name": "waiver blocked by exhausted ESPN acquisition limit",
      "teamId": "t1",
      "snapshotCase": "matchup-limit-exhausted",
      "expectedValid": false,
      "expectedCode": "acquisition-limit-exhausted",
      "recommendation": { "id": "fixture-limit-exhausted", "kind": "waiver", "status": "review", "confidence": "medium", "inputs": ["ESPN availability", "ESPN acquisition usage"], "limitations": ["ESPN transaction limits apply."], "payload": { "addPlayerId": "p15", "dropPlayerId": "p10" } }
    }
  ],
  "explanationCases": [
    {
      "name": "valid traceable explanation",
      "expectedValid": true,
      "expectedCodes": [],
      "recommendation": { "id": "explain-valid", "inputs": ["ESPN projection"], "limitations": ["Kickoff time is unavailable."] },
      "explanation": { "provider": "deterministic", "model": null, "recommendationId": "explain-valid", "text": "ESPN projection supports this review. Kickoff time is unavailable.", "generatedAt": null }
    },
    {
      "name": "explanation for wrong recommendation",
      "expectedValid": false,
      "expectedCodes": ["recommendation-id-mismatch"],
      "recommendation": { "id": "explain-target", "inputs": [], "limitations": [] },
      "explanation": { "provider": "fixture", "recommendationId": "different-target", "text": "No recommendation inputs were supplied." }
    },
    {
      "name": "explanation omits source input",
      "expectedValid": false,
      "expectedCodes": ["input-not-cited"],
      "recommendation": { "id": "explain-input", "inputs": ["ESPN injury status"], "limitations": [] },
      "explanation": { "provider": "fixture", "recommendationId": "explain-input", "text": "The roster should be reviewed." }
    },
    {
      "name": "explanation hides stated limitation",
      "expectedValid": false,
      "expectedCodes": ["limitation-omitted"],
      "recommendation": { "id": "explain-limit", "inputs": ["ESPN roster"], "limitations": ["Projection coverage is incomplete."] },
      "explanation": { "provider": "fixture", "recommendationId": "explain-limit", "text": "ESPN roster supports this recommendation." }
    },
    {
      "name": "explanation leaks an unexpected field",
      "expectedValid": false,
      "expectedCodes": ["explanation-field-unexpected"],
      "recommendation": { "id": "explain-extra", "inputs": [], "limitations": [] },
      "explanation": { "provider": "fixture", "recommendationId": "explain-extra", "text": "No source-dependent claim is made.", "rawPrompt": "must not pass" }
    },
    {
      "name": "explanation has malformed provider metadata",
      "expectedValid": false,
      "expectedCodes": ["model-invalid", "explanation-timestamp-invalid"],
      "recommendation": { "id": "explain-metadata", "inputs": [], "limitations": [] },
      "explanation": { "provider": "fixture", "model": "", "recommendationId": "explain-metadata", "text": "No source-dependent claim is made.", "generatedAt": "not-a-date" }
    },
    {
      "name": "explanation is not an object",
      "expectedValid": false,
      "expectedCodes": ["explanation-invalid"],
      "recommendation": { "id": "explain-shape", "inputs": [], "limitations": [] },
      "explanation": ["not", "an", "object"]
    }
  ]
}
