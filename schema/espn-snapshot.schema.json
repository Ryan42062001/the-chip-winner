{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-chip-winner.local/schema/espn-snapshot-v1.json",
  "title": "The Chip Winner ESPN Snapshot",
  "type": "object",
  "required": ["schemaVersion", "provider", "league", "currentWeek", "teams", "players", "rosters", "matchups"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "espn" },
    "meta": { "type": "object" },
    "league": {
      "type": "object",
      "required": ["id", "name"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "season": { "type": "integer" } }
    },
    "currentWeek": { "type": "integer", "minimum": 1 },
    "teams": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/team" } },
    "players": { "type": "array", "items": { "$ref": "#/$defs/player" } },
    "rosters": { "type": "array", "items": { "$ref": "#/$defs/roster" } },
    "matchups": { "type": "array", "items": { "$ref": "#/$defs/matchup" } },
    "availablePlayers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "team": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
    "player": { "type": "object", "required": ["id", "name", "position"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "position": { "enum": ["QB", "RB", "WR", "TE", "K", "D/ST"] }, "projection": { "type": ["number", "null"], "minimum": 0 } } },
    "roster": { "type": "object", "required": ["teamId", "entries"], "properties": { "teamId": { "type": "string" }, "entries": { "type": "array", "items": { "type": "object", "required": ["playerId", "lineupSlot"], "properties": { "playerId": { "type": "string" }, "lineupSlot": { "enum": ["QB", "RB", "WR", "TE", "FLEX", "OP", "K", "D/ST", "BE", "IR"] } } } } } },
    "matchup": { "type": "object", "required": ["week", "homeTeamId", "awayTeamId"], "properties": { "week": { "type": "integer", "minimum": 1 }, "homeTeamId": { "type": "string" }, "awayTeamId": { "type": "string" } } }
  }
}
