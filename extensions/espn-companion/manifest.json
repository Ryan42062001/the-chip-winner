{
  "manifest_version": 3,
  "name": "The Chip Winner — ESPN Companion",
  "version": "0.1.0",
  "description": "Connects The Chip Winner to the ESPN fantasy league already signed in within Chrome.",
  "permissions": ["storage"],
  "host_permissions": ["https://lm-api-reads.fantasy.espn.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://ryan42062001.github.io/the-chip-winner/*",
        "http://localhost:4173/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "The Chip Winner ESPN Companion" }
}
